{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ticktick": {
      "type": "stdio",
      "command": "bun",
      "args": ["${PLUGIN_ROOT}/servers/ticktick.ts"],
      "env": { "TICKTICK_ALLOW_COMPLETE": "0" }
    },
    "gmail": {
      "type": "stdio",
      "command": "bun",
      "args": ["${PLUGIN_ROOT}/servers/gmail.ts"]
    }
  }
}
