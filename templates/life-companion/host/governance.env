# Governance settings for this NanoClaw copy. Append to the project's .env
# (never commit .env itself), then restart the service.

# Agent containers get no internet route except through the credential gateway.
NANOCLAW_EGRESS_LOCKDOWN=true

# GET and HEAD requests to these APIs skip the approval card. Writes keep
# whatever approval rule the gateway applies, so set the gateway to hold
# writes to api.ticktick.com (see the README). Gmail's token is read-only
# at Google's end as well.
NANOCLAW_GATEWAY_READ_ONLY_HOSTS=gmail.googleapis.com,api.ticktick.com

# Keep a runaway session from starving the desktop.
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_CPU_LIMIT=2
